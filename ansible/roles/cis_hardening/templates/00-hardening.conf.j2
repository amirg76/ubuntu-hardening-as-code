# Loaded first: for most keywords the FIRST value sshd reads wins.
# Managed by Ansible (cis_hardening). Change the role, not this file.
PasswordAuthentication no
PermitRootLogin no
KbdInteractiveAuthentication no
X11Forwarding no
MaxAuthTries 3
AllowUsers {{ cis_hardening_ssh_allow_users | join(' ') }}
{% if cis_hardening_ssh_permit_open %}
# Local tunnels (ssh -L) only, and only to these targets. Remote (-R) stays off.
AllowTcpForwarding local
PermitOpen {{ cis_hardening_ssh_permit_open | join(' ') }}
{% else %}
AllowTcpForwarding no
{% endif %}
# PermitOpen covers TCP only: Unix-socket forwarding is a separate switch.
AllowStreamLocalForwarding no
AllowAgentForwarding no
# VERBOSE logs the fingerprint of the key used for each login.
LogLevel VERBOSE
LoginGraceTime 60
ClientAliveInterval 300
ClientAliveCountMax 3
# No SHA-1 and no 64-bit MACs.
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com,umac-128-etm@openssh.com,hmac-sha2-512,hmac-sha2-256
